# ============================================================
# PERLBOT_SHELLBOT — Suricata Rules
# Author  : AfterPacket
# Date    : 2026-08-07
# TLP     : TLP:WHITE
# SIDs    : 9003001-9003999
# ============================================================
#
# Perl IRC shellbot. C2 is cleartext IRC on 6667 — on a modern network
# any cleartext IRC egress from a server subnet is worth alerting on
# regardless of destination, so both a targeted and a generic rule ship
# here. Tune 9003003 to your environment before enabling.

alert ip $HOME_NET any -> 213.139.77.150 any ( \
  msg:"ET MALWARE PERLBOT_SHELLBOT outbound to IRC C2 213.139.77.150 (duba)"; \
  classtype:trojan-activity; \
  sid:9003001; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag PERLBOT_SHELLBOT; \
)

# Second C2, used by /dodu and /gots. Different host, different /16 —
# blocking only the first server leaves this one operating.
alert ip $HOME_NET any -> 213.177.179.11 any ( \
  msg:"ET MALWARE PERLBOT_SHELLBOT outbound to IRC C2 213.177.179.11 (dodu/gots)"; \
  classtype:trojan-activity; \
  sid:9003004; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag PERLBOT_SHELLBOT; \
)

alert tcp $HOME_NET any -> 213.139.77.150 6667 ( \
  msg:"ET MALWARE PERLBOT_SHELLBOT IRC registration to known C2"; \
  flow:established,to_server; \
  content:"NICK"; depth:8; \
  classtype:trojan-activity; \
  sid:9003002; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag PERLBOT_SHELLBOT; \
)

# Generic — catches this bot after an $ARGV[0] C2 override, which the
# targeted rules above would miss entirely. Higher noise; tune first.
alert tcp $HOME_NET any -> $EXTERNAL_NET 6667 ( \
  msg:"ET POLICY Cleartext IRC egress from server subnet (possible shellbot C2)"; \
  flow:established,to_server; \
  content:"NICK"; depth:8; \
  content:"USER"; distance:0; \
  classtype:policy-violation; \
  sid:9003003; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag PERLBOT_SHELLBOT; \
)

# The durable one. @channels=("#mot") is identical in all three samples and
# across BOTH C2 servers, and unlike the nick it is not randomised. This fires
# on ANY destination, so it survives the $ARGV[0] C2 override that defeats
# 9003001/9003002/9003004 — and it survives the operator moving servers.
# Any port, because the override can redirect to a non-standard one.
alert tcp $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"ET MALWARE PERLBOT_SHELLBOT joining operator channel #mot (C2-independent)"; \
  flow:established,to_server; \
  content:"JOIN"; depth:8; \
  content:"#mot"; distance:0; within:12; \
  classtype:trojan-activity; \
  sid:9003005; rev:1; \
  metadata:affected_product Any, created_at 2026-08-08, tag PERLBOT_SHELLBOT; \
)
