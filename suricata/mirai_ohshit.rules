# ============================================================
# MIRAI_OHSHIT — Suricata Rules
# Author  : AfterPacket
# Date    : 2026-08-07
# TLP     : TLP:WHITE
# SIDs    : 9001001-9001999
# ============================================================
#
# Loader chain staged from 94.154.43.123 over plain HTTP.
# The doubled slash in "//bot." is characteristic of this loader's
# URL construction and is the highest-value content match here.

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"ET MALWARE MIRAI_OHSHIT stage-1 fetch of ohshit.sh loader"; \
  flow:established,to_server; \
  http.method; content:"GET"; \
  http.uri; content:"/ohshit.sh"; endswith; \
  classtype:trojan-activity; \
  sid:9001001; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"ET MALWARE MIRAI_OHSHIT multi-arch payload fetch (doubled-slash //bot.)"; \
  flow:established,to_server; \
  http.uri; content:"//bot."; depth:6; \
  classtype:trojan-activity; \
  sid:9001002; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"ET MALWARE MIRAI_OHSHIT payload retrieval from known staging host"; \
  flow:established,to_server; \
  http.host; content:"94.154.43.123"; \
  classtype:trojan-activity; \
  sid:9001003; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

alert ip $HOME_NET any -> 94.154.43.123 any ( \
  msg:"ET MALWARE MIRAI_OHSHIT outbound to staging host 94.154.43.123"; \
  classtype:trojan-activity; \
  sid:9001004; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

# ------------------------------------------------------------
# C2 domains compiled into the ELF payloads.
# DNS rules fire at resolution — before any session is established —
# so these catch an infected host earlier than the IP rules below.
# ------------------------------------------------------------

alert dns $HOME_NET any -> any any ( \
  msg:"ET MALWARE MIRAI_OHSHIT C2 domain lookup (metrics-collector.io)"; \
  dns.query; content:"api-relay-3.metrics-collector.io"; nocase; isdataat:!1,relative; \
  classtype:trojan-activity; \
  sid:9001005; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

alert dns $HOME_NET any -> any any ( \
  msg:"ET MALWARE MIRAI_OHSHIT C2 domain lookup (hostcloud-eu.net)"; \
  dns.query; content:"cdn-edge-updates.hostcloud-eu.net"; nocase; isdataat:!1,relative; \
  classtype:trojan-activity; \
  sid:9001006; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

alert dns $HOME_NET any -> any any ( \
  msg:"ET MALWARE MIRAI_OHSHIT C2 domain lookup (serverstats-daemon.com)"; \
  dns.query; content:"mgmt-panel.serverstats-daemon.com"; nocase; isdataat:!1,relative; \
  classtype:trojan-activity; \
  sid:9001007; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

# Cloudflare Workers-hosted. Matched on the FULL hostname only —
# a substring match on workers.dev would fire on legitimate traffic.
alert dns $HOME_NET any -> any any ( \
  msg:"ET MALWARE MIRAI_OHSHIT C2 domain lookup (softwaremirror.workers.dev)"; \
  dns.query; content:"sync.softwaremirror.workers.dev"; nocase; isdataat:!1,relative; \
  classtype:trojan-activity; \
  sid:9001008; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

alert dns $HOME_NET any -> any any ( \
  msg:"ET MALWARE MIRAI_OHSHIT C2 domain lookup (glibc.malloc.top)"; \
  dns.query; content:"glibc.malloc.top"; nocase; isdataat:!1,relative; \
  classtype:trojan-activity; \
  sid:9001009; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

# ------------------------------------------------------------
# C2 IPs compiled into the ELF payloads.
# GitHub Pages (185.199.108.153) and Cloudflare (104.21.234.17) are also
# present in these binaries and are deliberately absent here.
# ------------------------------------------------------------

alert ip $HOME_NET any -> [45.61.161.207,45.83.140.28,5.101.221.87,51.15.68.114,94.130.53.201,195.201.24.6] any ( \
  msg:"ET MALWARE MIRAI_OHSHIT outbound to payload-embedded C2"; \
  classtype:trojan-activity; \
  sid:9001010; rev:1; \
  metadata:affected_product Any, created_at 2026-08-07, tag MIRAI_OHSHIT; \
)

# ------------------------------------------------------------
# Layer-7 HTTP flood — added 2026-08-08.
# The payloads carry an HTTP flood kit XOR-0x22 obfuscated in the config
# table: a rotating User-Agent pool and 20 Referer values taken from real
# sites (google.com, facebook.com, ...).
#
# DETECTION IS INHERENTLY RATE-BASED. Any single flood request is, by
# construction, indistinguishable from a legitimate browser request — that
# is the whole point of the Referer and UA rotation. Both rules below are
# therefore thresholded and describe OUTBOUND flooding by an infected host.
# Do not deploy them unthresholded.
# ------------------------------------------------------------

# The UA pool is entirely pre-Trident-7 Internet Explorer. A modern Linux
# server emitting MSIE 8/9/10 user agents at volume is not browsing.
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"ET MALWARE MIRAI_OHSHIT possible L7 flood (archaic MSIE UA at volume from server subnet)"; \
  flow:established,to_server; \
  http.method; content:"GET"; \
  http.user_agent; content:"compatible|3b| MSIE "; \
  http.user_agent; content:"Trident/"; distance:0; \
  threshold:type threshold, track by_src, count 100, seconds 60; \
  classtype:attempted-dos; \
  sid:9001011; rev:1; \
  metadata:affected_product Any, created_at 2026-08-08, tag MIRAI_OHSHIT; \
)

# Same traffic seen from the Referer side. The pool is fixed, so a host
# cycling several of these at rate is running the flood loop, not browsing.
# news.ycombinator.com and t.co are used because they are the least likely
# of the twenty to appear as a Referer in ordinary server-subnet egress.
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"ET MALWARE MIRAI_OHSHIT possible L7 flood (embedded Referer pool at volume)"; \
  flow:established,to_server; \
  http.method; content:"GET"; \
  http.referer; content:"https://news.ycombinator.com/"; \
  threshold:type threshold, track by_src, count 50, seconds 60; \
  classtype:attempted-dos; \
  sid:9001012; rev:1; \
  metadata:affected_product Any, created_at 2026-08-08, tag MIRAI_OHSHIT; \
)
