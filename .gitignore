# Extracted artifacts and scratch space are never committed.
# Only the AES-256 encrypted archives under samples/ are tracked.
*.bin
*.elf
/tmp/
/scratch/
/work/

# Incoming loot archives live outside the repo
drosera-loot-*.zip

# Editor and agent configuration — local to the operator's machine, never
# published. These stay on disk so tooling keeps working; they are simply
# not tracked.
.zed/
.claude/

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
.vscode/
